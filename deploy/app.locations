client_max_body_size 80m;

# Everything goes to the API, which serves the dashboard, the public menu
# pages (/{shop}, /t/…, /o/…, /b/…, /d/…) and the generated marketing pages
# itself. One router — the server — decides what a path is, so a new shop
# address works without touching nginx.

proxy_http_version 1.1;
proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host  $host;

# Live queue, ticket, order and TV streams: no buffering, long reads.
location ~ ^/api/(public/(queues|tickets|orders|display)/[^/]+/stream|queue/[0-9]+/stream|orders/stream|bookings/stream)$ {
    proxy_pass http://wam_api;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
    add_header X-Accel-Buffering no;
}

location /api/ {
    proxy_pass http://wam_api;
    # Campaigns and the QR poll are long-lived; the default 60s cuts them off.
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
}

# Hashed assets of both apps: cache hard at the edge too.
location ~ ^/(mw/)?assets/ {
    proxy_pass http://wam_api;
    expires 1y;
    add_header Cache-Control "public, immutable";
}

location / {
    proxy_pass http://wam_api;
}
