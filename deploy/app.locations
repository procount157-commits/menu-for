client_max_body_size 80m;

location /api/ {
    proxy_pass http://wam_api;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Campaigns and the QR poll are long-lived; the default 60s cuts them off.
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
}

# Tracking redirects are served by the API too.
location /t/ { proxy_pass http://wam_api; proxy_set_header Host $host; }

location / {
    root /usr/share/nginx/html;
    try_files $uri $uri/ /index.html;   # SPA
}

location ~* \.(js|css|png|jpg|jpeg|gif|svg|webp|woff2?)$ {
    root /usr/share/nginx/html;
    expires 1y;
    add_header Cache-Control "public, immutable";
}
