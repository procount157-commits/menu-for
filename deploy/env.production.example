# Copy to .env at the repo root on the VPS, fill in, then run deploy/deploy.sh.
# Everything here is read by docker-compose.

POSTGRES_USER=wam
POSTGRES_DB=menu4u
# openssl rand -base64 24
POSTGRES_PASSWORD=

# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

SENDING_TIMEZONE=Asia/Dubai
SENDING_HOUR_START=9
SENDING_HOUR_END=21

# One key is enough. See the README for where to get each.
# ZHIPU_API_KEY=        # glm-4-flash, free outright
# GEMINI_API_KEY=
# GROQ_API_KEY=
# QWEN_API_KEY=
# LLM_PROVIDER=zhipu

# Where the heartbeat sends alerts (optional).
# HEARTBEAT_WEBHOOK=

# Public address, for canonical links and the sitemap (https://your-domain.com)
SITE_URL=
