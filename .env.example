# Copy to .env and fill in. Never commit the filled copy.
DATABASE_URL=postgresql://user:password@host:5432/whatsapp_marketer
SESSION_SECRET=generate-with-node-crypto-randomBytes-48-hex
PORT=8080
NODE_ENV=development

# Optional: seeds the first admin on boot (see README).
# ADMIN_PHONE=
# ADMIN_PASSWORD=

# Sending hours — campaigns pause outside this window (recipient complaints
# drive bans, and a 3am message earns them). Set ENABLED=false to disable.
# SENDING_HOURS_ENABLED=true
# SENDING_TIMEZONE=Asia/Dubai
# SENDING_HOUR_START=9
# SENDING_HOUR_END=21
