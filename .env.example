# Copy to .env and fill in. Never commit the filled copy.
DATABASE_URL=postgresql://user:password@host:5432/whatsapp_marketer
SESSION_SECRET=generate-with-node-crypto-randomBytes-48-hex
PORT=8080
NODE_ENV=development

# Optional: seeds the first admin on boot (see README).
# ADMIN_PHONE=
# ADMIN_PASSWORD=

# Sending hours — campaigns pause outside this window (recipient complaints
# drive bans, and a 3am message earns them). Set ENABLED=false to disable.
# SENDING_HOURS_ENABLED=true
# SENDING_TIMEZONE=Asia/Dubai
# SENDING_HOUR_START=9
# SENDING_HOUR_END=21

# Media storage. Local disk by default; set MEDIA_DIR to move it.
# Setting DEFAULT_OBJECT_STORAGE_BUCKET_ID switches to Google Cloud Storage
# (only reachable from a Replit deployment, via its sidecar).
# MEDIA_DIR=./artifacts/api-server/uploads
# DEFAULT_OBJECT_STORAGE_BUCKET_ID=

# ── Bot intelligence ──────────────────────────────────────────────
# Optional. Without a key the bot answers with the matching knowledge-base
# entry verbatim: accurate, just not conversational. With one it writes the
# answer in its own words, still grounded in those entries only.
# Any one of these is enough. Tried in the order listed when LLM_PROVIDER is
# unset, so adding a second key is a fallback rather than a conflict.
#
#   Claude       https://console.anthropic.com/settings/keys     — paid per token.
#                A claude.ai Pro/Max subscription is NOT API access and grants
#                no API credits; the API is billed separately.
#                ANTHROPIC_MODEL defaults to claude-opus-5. For a reply bot,
#                claude-haiku-4-5 costs about a fifth as much and is usually
#                enough, since answers are short and grounded in the knowledge
#                base rather than reasoned from scratch.
#   Gemini       https://aistudio.google.com/apikey              — best Arabic
#   Zhipu GLM    https://open.bigmodel.cn/usercenter/apikeys     — glm-4-flash is free outright
#   Groq         https://console.groq.com/keys                   — fastest
#   Qwen         https://dashscope.console.aliyun.com/apiKey     — free quota, good Arabic
#   SiliconFlow  https://cloud.siliconflow.cn/account/ak         — several free models
#   OpenRouter   https://openrouter.ai/keys                      — ":free" models
#   DeepSeek     https://platform.deepseek.com/api_keys          — trial credit, then very cheap
#   Moonshot     https://platform.moonshot.cn/console/api-keys   — trial credit
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
# GEMINI_API_KEY=
# ZHIPU_API_KEY=
# GROQ_API_KEY=
# QWEN_API_KEY=
# SILICONFLOW_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# LLM_PROVIDER=zhipu

# The public address of the site, used for canonical links, Open Graph and
# the sitemap of the generated marketing pages. Leave unset and the pages
# still build, with relative links and no sitemap.
SITE_URL=

# Registration is by invitation (a coupon code from the admin page). Set to
# true to let anyone sign up.
OPEN_REGISTRATION=
# Origins allowed to call the API cross-origin with credentials, comma-separated.
CORS_ORIGINS=
# Hours a number must have been linked before its first campaign (default 48).
WARMUP_MIN_HOURS=
# Full chat history sync per linked number (default true).
WA_FULL_HISTORY=
