# Copy to .env and fill in. Never commit the filled copy.
DATABASE_URL=postgresql://user:password@host:5432/whatsapp_marketer
SESSION_SECRET=generate-with-node-crypto-randomBytes-48-hex
PORT=8080
NODE_ENV=development

# Optional: seeds the first admin on boot (see README).
# ADMIN_PHONE=
# ADMIN_PASSWORD=

# Sending hours — campaigns pause outside this window (recipient complaints
# drive bans, and a 3am message earns them). Set ENABLED=false to disable.
# SENDING_HOURS_ENABLED=true
# SENDING_TIMEZONE=Asia/Dubai
# SENDING_HOUR_START=9
# SENDING_HOUR_END=21

# Media storage. Local disk by default; set MEDIA_DIR to move it.
# Setting DEFAULT_OBJECT_STORAGE_BUCKET_ID switches to Google Cloud Storage
# (only reachable from a Replit deployment, via its sidecar).
# MEDIA_DIR=./artifacts/api-server/uploads
# DEFAULT_OBJECT_STORAGE_BUCKET_ID=

# ── Bot intelligence ──────────────────────────────────────────────
# Optional. Without a key the bot answers with the matching knowledge-base
# entry verbatim: accurate, just not conversational. With one it writes the
# answer in its own words, still grounded in those entries only.
#   Gemini     https://aistudio.google.com/apikey   — best Arabic
#   Groq       https://console.groq.com/keys        — fastest
#   OpenRouter https://openrouter.ai/keys           — free models
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# LLM_PROVIDER=gemini
